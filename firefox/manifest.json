{
  "manifest_version": 2,
  "name": "Tetra Passwords",
  "description": "Your Tetra Passwords in Firefox: logins and 2FA codes, filled on sites, new and changed logins saved to Tetra, strong passwords suggested.",
  "version": "0.1.0",
  "author": "Tetra",
  "browser_specific_settings": {
    "gecko": { "id": "tetra-passwords@tetra.local", "strict_min_version": "115.0" }
  },
  "icons": { "64": "icon.png" },
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_icon": "icon.png", "default_title": "Tetra Passwords", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }],
  "permissions": ["storage", "activeTab", "clipboardWrite", "http://127.0.0.1/*"]
}
